CREATE TABLE events (
    timestamp TIMESTAMP,
    timestamp_day DATE,
    employee_id NUMBER,
    case_id VARCHAR2(255),
    event_category VARCHAR2(256),
    event_name VARCHAR2(256),
    event_property VARCHAR2(256)
);



WITH session_journey AS (
    SELECT 
        case_id,
        timestamp_day,
        --Базовые метрики
        MAX(CASE WHEN event_category = 'session' AND event_name = 'Sign In' THEN 1 ELSE 0 END) as session_started,
        MAX(CASE WHEN event_category = 'main' AND event_name = 'Submit > Response' THEN 1 ELSE 0 END) as main_completed,
        MAX(CASE WHEN event_category = 'identification' AND event_name = 'Submit > Response' THEN 1 ELSE 0 END) as identification_completed,
        MAX(CASE WHEN event_category = 'addresses' AND event_name = 'Submit > Response' THEN 1 ELSE 0 END) as addresses_completed,
        MAX(CASE WHEN event_category = 'employment' AND event_name = 'Submit > Response' THEN 1 ELSE 0 END) as employment_completed,
        MAX(CASE WHEN event_category = 'docsUpload' AND event_name = 'Submit > Response' THEN 1 ELSE 0 END) as docs_upload_completed,
        MAX(CASE WHEN event_category = 'summary' AND event_name = 'Submit > Response' THEN 1 ELSE 0 END) as summary_completed,
        MAX(CASE WHEN event_category = 'result' AND event_name = 'Submit > Response' THEN 1 ELSE 0 END) as final_completed,
        -- Поведенческие метрики
        MAX(CASE WHEN event_category = 'addresses' AND event_name IN ('Open > Manual livingAddress', 'Open > Manual regAddress') THEN 1 ELSE 0 END) as used_manual_address,
        MAX(CASE WHEN event_category = 'cards' AND event_name = 'Click > Add card' THEN 1 ELSE 0 END) as added_cards,
        COUNT(CASE WHEN event_category = 'cards' AND event_name = 'Click > Add card' THEN 1 END) as cards_added_count,
        COUNT(CASE WHEN event_category = 'cards' AND event_name = 'Click > Remove card' THEN 1 END) as cards_removed_count,
        MAX(CASE WHEN event_category = 'accessCard' AND event_name = 'Submit > Response' THEN 1 ELSE 0 END) as attempted_card_issue,
        MAX(CASE WHEN event_category = 'accessCard' AND event_name = 'Submit > Response' AND event_property = 'true' THEN 1 ELSE 0 END) as successful_card_issue,
        MAX(CASE WHEN event_category = 'nonResidentInfo' AND event_name = 'Submit > Response' THEN 1 ELSE 0 END) as is_non_resident,
        MAX(CASE WHEN event_category = 'docsUpload' AND event_name = 'Scan > Start' THEN 1 ELSE 0 END) as attempted_scan,
        MAX(CASE WHEN event_category = 'docsUpload' AND event_name = 'Submit > Response' THEN 1 ELSE 0 END) as successful_scan,
        MAX(CASE WHEN event_name = 'Click > Back' THEN 1 ELSE 0 END) as used_back_button,
        MAX(CASE WHEN event_category = 'result' AND event_name = 'Submit > Response' AND event_property = 'SES' THEN 1 ELSE 0 END) as used_esign
        
    from U.LOGS_SCREEN_FORMS_4s
    GROUP BY case_id, timestamp_day
),
daily_metrics AS (
    SELECT 
        timestamp_day,
        -- Базовые метрики
        COUNT(*) as started_sessions,
        SUM(final_completed) as completed_sessions,
        SUM(main_completed) as main_completed,
        SUM(identification_completed) as identification_completed,
        SUM(addresses_completed) as addresses_completed,
        SUM(employment_completed) as employment_completed,
        SUM(docs_upload_completed) as docs_upload_completed,
        SUM(summary_completed) as summary_completed,
        -- Поведенческие метрики
        SUM(used_manual_address) as sessions_with_manual_address,
        SUM(added_cards) as sessions_adding_cards,
        SUM(cards_added_count) as total_cards_added,
        SUM(cards_removed_count) as total_cards_removed,
        SUM(attempted_card_issue) as sessions_with_card_attempt,
        SUM(successful_card_issue) as sessions_with_card_success,
        SUM(is_non_resident) as non_resident_sessions,
        SUM(attempted_scan) as sessions_with_scan_start,
        SUM(successful_scan) as sessions_with_scan_end,
        SUM(used_back_button) as sessions_with_back_clicks,
        SUM(used_esign) as esign_sessions
    FROM session_journey
    GROUP BY timestamp_day
)
SELECT 
    timestamp_day as "Дата",
    
    -- 1. МЕТРИКИ ЭФФЕКТИВНОСТИ ПРОЦЕССА
    -- Общая конверсия
    ROUND(completed_sessions * 100.0 / NULLIF(started_sessions, 0), 2) as "Общая конверсия, %",
    ROUND(identification_completed * 100.0 / NULLIF(started_sessions, 0), 2) as "Дошли до идентификации, %",
    ROUND(addresses_completed * 100.0 / NULLIF(started_sessions, 0), 2) as "Дошли до адресов, %",
    ROUND(employment_completed * 100.0 / NULLIF(started_sessions, 0), 2) as "Дошли до занятости, %",
    ROUND(docs_upload_completed * 100.0 / NULLIF(started_sessions, 0), 2) as "Дошли до документов, %",
    
    
    -- 2. ПОВЕДЕНЧЕСКИЕ МЕТРИКИ
    -- Ручной ввод адресов: только от тех, кто дошел до адресов
    ROUND(sessions_with_manual_address * 100.0 / NULLIF(addresses_completed, 0), 2) as "Сессий с ручным вводом адресов, %",
    
    -- Метрики работы с картами
    ROUND(sessions_adding_cards * 100.0 / NULLIF(started_sessions, 0), 2) as "Сессий с добавлением карт, %",
    ROUND(total_cards_added * 1.0 / NULLIF(sessions_adding_cards, 0), 2) as "Среднее карт на активного пользователя",
    ROUND(total_cards_removed * 100.0 / NULLIF(total_cards_added, 0), 2) as "Процент отказов от карт, %",
    
    -- Доля выдачи моментальных карт
    ROUND(sessions_with_card_success * 100.0 / NULLIF(sessions_with_card_attempt, 0), 2) as "Успешная выдача карт, %",
    
    -- Доля нерезидентов
    ROUND(non_resident_sessions * 100.0 / NULLIF(started_sessions, 0), 2) as "Доля нерезидентов, %",
    
    -- 3. МЕТРИКИ КАЧЕСТВА
    ROUND(sessions_with_scan_start * 100.0 / NULLIF(started_sessions, 0), 2) as "Сессий использовали сканирование, %",
    ROUND(sessions_with_scan_end * 100.0 / NULLIF(sessions_with_scan_start, 0), 2) as "Успешность сканирования, %",
    ROUND(esign_sessions * 100.0 / NULLIF(completed_sessions, 0), 2) as "Доля ЭП, %",
    
    -- АБСОЛЮТНЫЕ ПОКАЗАТЕЛИ
    started_sessions as "Начато сессий",
    completed_sessions as "Успешно завершено",
    addresses_completed as "Дошли до адресов"
FROM daily_metrics
ORDER BY timestamp_day DESC;



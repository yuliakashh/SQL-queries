WITH t1 AS
(SELECT dimension_4
FROM intra.event_log
WHERE
application_id = 'SFAProd' AND
event_category = 'UL.33.01' AND
event_name = 'Client Card > Opportunities > Selling' AND
timestamp BETWEEN
    DATE_TRUNC('month', ADD_MONTHS(CURRENT_DATE, -12))
    AND DATE_TRUNC('month', CURRENT_DATE) - INTERVAL '1' DAY AND
dimension_1 LIKE 'SCRMFW:MB%'),
t2 AS
(SELECT dimension_4
FROM intra.event_log
WHERE
application_id = 'SFAProd' AND
event_category = 'UL.33.03' AND
event_name = 'Client Card > Opportunities > SetRefuse' AND
timestamp BETWEEN
    DATE_TRUNC('month', ADD_MONTHS(CURRENT_DATE, -12))
    AND DATE_TRUNC('month', CURRENT_DATE) - INTERVAL '1' DAY AND
dimension_1 LIKE 'SCRMFW:MB%'),
t3 AS
(SELECT t1.dimension_4 AS status_1
FROM t1 INNER JOIN t2 ON t1.dimension_4 = t2.dimension_4
WHERE t1.dimension_4 IS NOT NULL),
t4 AS
 
(SELECT
logs.dimension_1,
logs.dimension_3,
logs.event_uuid,
logs.timestamp,
logs.timestamp_day,
logs.dimension_2 as mnemonic,
dict.MMB_DIVISION as division,
dict.MMB_CITY_MAIN as city,
logs.dimension_4 as deal_id,
CASE
WHEN logs.dimension_1 LIKE '%TERR%' THEN 'Канал развития'
WHEN logs.dimension_1 LIKE '%FIELD%' THEN 'Полевой канал'
WHEN logs.dimension_1 LIKE '%TM%' THEN 'Телемаркетинг'
WHEN logs.dimension_1 LIKE '%PARTNER%' THEN 'Партнерский канал'
WHEN logs.dimension_1 LIKE '%KMR%' THEN 'Канал развития'
WHEN logs.dimension_1 LIKE '%CSF%' THEN 'Канал развития'
WHEN logs.dimension_1 LIKE '%OFFICE%' THEN 'Канал отделений'
WHEN logs.dimension_1 LIKE '%TS%' THEN 'Телесейлс'
WHEN logs.dimension_1 LIKE '%OFFICE%' THEN 'Канал отделений'
WHEN logs.dimension_1 LIKE '%Online%' OR  logs.dimension_1 LIKE '%ONLINE%' THEN 'Онлайн канал'
WHEN logs.dimension_1 LIKE '%ONB%' THEN 'Онбординг'
WHEN logs.dimension_1 LIKE '%LA%' THEN 'LA'
WHEN logs.dimension_1 LIKE '%SOHR%' THEN 'SOHR'
END AS channel,
CASE
WHEN logs.dimension_7 LIKE '%EL_BANKGUARANREE%' THEN 'Электронное банковское поручительство'
WHEN logs.dimension_7 LIKE '%ACQUIRING_NEW%' THEN 'Новый эквайринг'
WHEN logs.dimension_7 LIKE '%ACQUIRING_CORP%' THEN 'Корпоративный эквайринг'
WHEN logs.dimension_7 LIKE '%MASSPAY%' THEN 'Платёжный сервис MAS Pay'
WHEN logs.dimension_7 LIKE '%Leasing%' THEN 'Лизинг'
WHEN logs.dimension_7 LIKE '%CBCREDIT%' THEN 'Кредитный продукт CBCredit'
WHEN logs.dimension_7 LIKE '%BANKGUARANREE%' THEN 'Банковское поручительство'
WHEN logs.dimension_7 LIKE '%INTERNETACQUIRING_CORP%' THEN 'Корпоративный интернет‑эквайринг'
WHEN logs.dimension_7 LIKE '%A_CASHBOX%' THEN 'Кассовый модуль A‑Cashbox'
WHEN logs.dimension_7 LIKE '%SALLARY_PROJECT%' THEN 'Зарплата'
WHEN logs.dimension_7 LIKE '%RKO%' THEN 'Расчётно‑кассовое обслуживание'
WHEN logs.dimension_7 LIKE '%FACTORING%' OR event_category = 'UL.33.01' THEN 'Факторинг'
WHEN logs.dimension_7 LIKE '%VED%' THEN 'Внутренний сервис VED'
WHEN logs.dimension_7 LIKE '%INTERNETACQUIRING_NEW%' OR dimension_7 LIKE 'INTERNETACQ_NEW' THEN 'Новый интернет‑эквайринг'
WHEN logs.dimension_7 LIKE '%SBP_NEW%' THEN 'Новый сервис быстрых платежей'
WHEN logs.dimension_7 LIKE '%CREDIT%' THEN 'Кредитный продукт'
WHEN logs.dimension_7 LIKE '%AgentContract%' THEN 'Агентский договор'
WHEN logs.dimension_7 LIKE '%NONFIN%' THEN 'Нефинансовый сервис'
WHEN logs.dimension_7 LIKE '%CC_CB9%' THEN 'Карта CC CB9'
WHEN logs.dimension_7 LIKE '%DEPOSITTRUNCATED%' THEN 'Упрощённый депозит'
WHEN logs.dimension_7 LIKE '%ACASH%' THEN 'Карта A‑Cash'
WHEN logs.dimension_7 LIKE '%APAY%' THEN 'Платёжный сервис A‑Pay'
WHEN logs.dimension_7 LIKE '%ACASH%' THEN 'Карта A‑Cash'
END as product,
CASE
WHEN logs.event_category = 'UL.17.01' AND logs.event_name = 'New Client Communication > Add Opportunity > Save' THEN 'Коммуникация'
WHEN logs.event_category = 'UL.17.02' AND logs.event_name = 'Lead UL Convert form > Convert' THEN 'Лид'
WHEN (logs.event_category = 'UL.17.04' AND logs.event_name = 'ClientCard UL > Offers > Process') OR (logs.event_category = 'UL.33.01' AND logs.event_name = 'Client Card > Opportunities > Selling') THEN 'Карточка клиента ЮЛ'
WHEN logs.event_category = 'UL.17.04' AND logs.event_name = 'MK > Process' THEN 'MK'
END AS source,
CASE
WHEN t3.status_1 is NOT NULL
THEN 'отказ' ELSE 'не проставлено' END AS result
FROM intra.event_log logs
LEFT JOIN t3
ON logs.dimension_4 = t3.status_1
INNER JOIN intra_sandbox.mmb_dict_mnemonic dict ON logs.dimension_2 = dict.MMB_MNEM
WHERE
logs.application_id = 'SFAProd' AND
logs.event_category IN ('UL.17.01', 'UL.17.02', 'UL.17.04', 'UL.33.01') AND
logs.timestamp BETWEEN
    DATE_TRUNC('month', ADD_MONTHS(CURRENT_DATE, -12))
    AND DATE_TRUNC('month', CURRENT_DATE) - INTERVAL '1' DAY AND
logs.dimension_1 LIKE 'SCRMFW:MB%')
 
SELECT
dimension_1, dimension_3, event_uuid,  timestamp, timestamp_day, mnemonic, division, city, deal_id,
channel, product, source, result
FROM t4
GROUP BY
dimension_1, dimension_3, event_uuid,  timestamp, timestamp_day, mnemonic, division, city, deal_id,
channel, product, source, result
